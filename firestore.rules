rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email == "abdulrahman2009hany2009@gmail.com"
        && request.auth.token.email_verified == true;
    }
    function validName() {
      return request.resource.data.n is string
        && request.resource.data.n.size() > 0 && request.resource.data.n.size() <= 30;
    }
    function isMember(g) {
      return request.auth != null
        && request.auth.uid in get(/databases/$(database)/documents/groups/$(g)).data.mb;
    }

    match /players/{uid} {
      allow read: if request.auth != null;
      allow create: if isAdmin() || (request.auth.uid == uid
        && request.resource.data.g in ['m','f'] && validName()
        && !('adj' in request.resource.data) && !('ov' in request.resource.data));
      allow update: if isAdmin() || (request.auth.uid == uid
        && request.resource.data.g == resource.data.g && validName()
        && request.resource.data.get('adj', []) == resource.data.get('adj', [])
        && request.resource.data.get('ov', {}) == resource.data.get('ov', {}));
      allow delete: if isAdmin();
    }

    match /ticketLocks/{u} {
      allow read: if request.auth != null && (request.auth.uid == u || isAdmin());
      allow create: if request.auth != null && (request.auth.uid == u || isAdmin())
        && request.resource.data.keys().hasOnly(["t"]) && request.resource.data.t is string;
      allow delete: if request.auth != null && (isAdmin()
        || (request.auth.uid == u && (
              !exists(/databases/$(database)/documents/tickets/$(resource.data.t))
              || get(/databases/$(database)/documents/tickets/$(resource.data.t)).data.st == "closed")));
    }

    match /tickets/{id} {
      function closeOnly() {
        return request.resource.data.diff(resource.data).affectedKeys().hasOnly(["st","ct"])
          && request.resource.data.st == "closed";
      }
      function followUp() {
        let nf = request.resource.data.get("fu", []);
        let pf = resource.data.get("fu", []);
        return request.resource.data.diff(resource.data).affectedKeys().hasOnly(["fu","st"])
          && request.resource.data.st == "open"
          && nf.size() == pf.size() + 1 && nf.size() <= 60
          && nf.hasAll(pf)
          && nf[nf.size() - 1].keys().hasOnly(["f","m","t"])
          && nf[nf.size() - 1].f == "u"
          && nf[nf.size() - 1].m is string
          && nf[nf.size() - 1].m.size() > 0 && nf[nf.size() - 1].m.size() <= 800
          && nf[nf.size() - 1].t is number;
      }
      allow create: if request.resource.data.keys().hasOnly(["uid","n","em","m","st","ts"])
        && request.resource.data.m is string && request.resource.data.m.size() > 0 && request.resource.data.m.size() <= 800
        && request.resource.data.n is string && request.resource.data.n.size() <= 60
        && request.resource.data.em is string && request.resource.data.em.size() <= 120
        && request.resource.data.st == "open"
        && request.resource.data.ts == request.time
        && (
          (request.resource.data.uid == "" && id.matches('a[a-z0-9]{24}'))
          || (request.auth != null && request.resource.data.uid == request.auth.uid
              && exists(/databases/$(database)/documents/ticketLocks/$(request.auth.uid))
              && get(/databases/$(database)/documents/ticketLocks/$(request.auth.uid)).data.t == id)
        );
      allow get: if resource.data.uid == ""
        || (request.auth != null && (resource.data.uid == request.auth.uid || isAdmin()));
      allow list: if request.auth != null && (isAdmin() || resource.data.uid == request.auth.uid);
      allow update: if isAdmin()
        || ((resource.data.uid == "" || (request.auth != null && resource.data.uid == request.auth.uid))
            && resource.data.st != "closed" && (closeOnly() || followUp()));
    }

    match /groups/{g} {
      allow create: if request.auth != null && request.resource.data.o == request.auth.uid
        && request.resource.data.mb == [request.auth.uid];
      allow read: if request.auth != null && request.auth.uid in resource.data.mb;
      allow update: if request.auth != null && (
        (request.auth.uid in request.resource.data.mb
          && request.resource.data.mb.hasAll(resource.data.mb)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["mb","mem"]))
        ||
        (request.auth.uid in resource.data.mb
          && !(request.auth.uid in request.resource.data.mb)
          && request.resource.data.mb.size() == resource.data.mb.size() - 1
          && request.resource.data.mb.hasAll(resource.data.mb.removeAll([request.auth.uid]))
          && request.resource.data.o in request.resource.data.mb
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["mb","mem","o","ad"]))
        ||
        (request.auth.uid in resource.data.mb
          && (resource.data.o == request.auth.uid
              || request.auth.uid in resource.data.get("ad", [])
              || resource.data.get("ae", false) == true)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["n","img"])
          && request.resource.data.n is string
          && request.resource.data.n.size() > 0 && request.resource.data.n.size() <= 30
          && request.resource.data.get("img", "").size() < 60000)
        ||
        (resource.data.o == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["ad","ae"])
          && request.resource.data.get("ae", false) is bool
          && request.resource.data.get("ad", []).hasOnly(resource.data.mb)));
      allow delete: if request.auth != null && resource.data.o == request.auth.uid;
      match /posts/{p} {
        allow read: if isMember(g);
        allow update: if isMember(g)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["rx"])
          && request.resource.data.rx.diff(resource.data.get("rx", {})).affectedKeys().hasOnly([request.auth.uid])
          && (!(request.auth.uid in request.resource.data.rx)
              || request.resource.data.rx[request.auth.uid] in ["l","u","d","f"]);
        match /comments/{c} {
          allow read: if isMember(g);
          allow create: if isMember(g)
            && request.resource.data.keys().hasOnly(["uid","n","g","a","t","ts"])
            && request.resource.data.uid == request.auth.uid
            && request.resource.data.t is string
            && request.resource.data.t.size() > 0 && request.resource.data.t.size() <= 300
            && request.resource.data.ts == request.time;
          allow delete: if request.auth != null && (resource.data.uid == request.auth.uid
            || get(/databases/$(database)/documents/groups/$(g)/posts/$(p)).data.uid == request.auth.uid
            || get(/databases/$(database)/documents/groups/$(g)).data.o == request.auth.uid);
        }
        allow create: if isMember(g) && request.resource.data.uid == request.auth.uid
          && request.resource.data.img.size() < 400000;
        allow delete: if request.auth != null && (resource.data.uid == request.auth.uid
          || get(/databases/$(database)/documents/groups/$(g)).data.o == request.auth.uid);
      }
    }

    match /codes/{c} {
      allow get: if request.auth != null;
      allow create: if request.auth != null;
      allow delete: if request.auth != null
        && get(/databases/$(database)/documents/groups/$(resource.data.g)).data.o == request.auth.uid;
    }

    match /notifs/{id} {
      allow create: if request.auth != null && request.resource.data.from == request.auth.uid;
      allow read, delete: if request.auth != null && resource.data.to == request.auth.uid;
    }

    match /tokens/{u} {
      allow write: if request.auth != null && request.auth.uid == u;
    }
  }
}
